---
import { url } from '../lib/url';
import { formatPeriod, type Work } from '../lib/works';
import Thumbnail from './Thumbnail.astro';

interface Props {
  works: Work[];
  /** 見出しレベル（ページ内の位置に合わせる） */
  headingLevel?: 'h2' | 'h3';
  /**
   * 指定すると、最初はこの件数だけ表示し、
   * スクロールで step 件ずつフェードインで追加表示する（JS が無効なら全件表示）
   */
  initial?: number;
  step?: number;
}

const { works, headingLevel = 'h3', initial, step = 3 } = Astro.props;
const progressive = initial !== undefined && works.length > initial;
const Heading = headingLevel;
---

<ul class="work-grid" data-progressive={progressive ? '' : undefined} data-step={step}>
  {
    works.map((work, i) => (
      <li class="work" data-category={work.data.category} data-pending={progressive && i >= initial! ? '' : undefined}>
        <Thumbnail src={work.data.thumbnail} alt={work.data.thumbnailAlt} category={work.data.category} />
        <div class="body">
        <p class="meta">
          <span class="category">{work.data.category}</span>
          <span class="period">{formatPeriod(work.data.start, work.data.end)}</span>
        </p>
        <Heading class="title">
          <a href={url(`works/${work.id}`)}>{work.data.title}</a>
        </Heading>
        <p class="summary">{work.data.summary}</p>
        <dl class="facts">
          <div>
            <dt>業界</dt>
            <dd>{work.data.domain}</dd>
          </div>
          <div>
            <dt>役割</dt>
            <dd>{work.data.role}</dd>
          </div>
        </dl>
        <ul class="tags" aria-label="使用技術">
          {work.data.tech.map((t) => <li>{t}</li>)}
        </ul>
        </div>
      </li>
    ))
  }
</ul>

{
  progressive && (
    <div class="more" data-more>
      <p class="more-hint" aria-live="polite">
        スクロールすると続きを表示します（残り<span data-remaining>{works.length - initial!}</span>件）
      </p>
    </div>
  )
}

<script>
  // 残りの実績を、スクロールに合わせて step 件ずつフェードインで表示する
  document.querySelectorAll<HTMLUListElement>('.work-grid[data-progressive]').forEach((grid) => {
    const step = Number(grid.dataset.step) || 3;
    const more = grid.nextElementSibling as HTMLElement | null;
    const remainingEl = more?.querySelector<HTMLElement>('[data-remaining]');
    if (!more) return;

    const pending = () => grid.querySelectorAll<HTMLElement>('.work[data-pending]');

    const revealNext = () => {
      const batch = Array.from(pending()).slice(0, step);
      batch.forEach((item, n) => {
        item.style.setProperty('--n', String(n));
        item.removeAttribute('data-pending');
        item.classList.add('is-revealed');
      });
      const left = pending().length;
      if (remainingEl) remainingEl.textContent = String(left);
      if (left === 0) {
        observer.disconnect();
        more.hidden = true;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        revealNext();
        // 画面が縦に長く、まだ見えている場合は続けて表示する
        requestAnimationFrame(() => {
          const r = more.getBoundingClientRect();
          if (!more.hidden && r.top < window.innerHeight) {
            observer.unobserve(more);
            observer.observe(more);
          }
        });
      },
      { rootMargin: '0px 0px 120px 0px' },
    );
    observer.observe(more);
  });
</script>

<style>
  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .work {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 150ms ease;
  }
  .work :global(.thumb) {
    border-bottom: 1px solid var(--line);
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem 1.25rem;
  }
  .work:hover {
    border-color: var(--accent);
  }

  /* 段階表示：JS が動くときだけ未表示分を隠す */
  :global(html.js) .work[data-pending] {
    display: none;
  }
  .work.is-revealed {
    animation: work-fade 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--n, 0) * 120ms);
  }
  @keyframes work-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .more {
    display: none;
  }
  :global(html.js) .more:not([hidden]) {
    display: block;
    padding-top: 1.5rem;
    text-align: center;
  }
  .more-hint {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .category {
    color: var(--accent);
    font-weight: 500;
  }

  .title {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* カード全体をクリック可能にする */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .work:hover .title a {
    color: var(--accent);
  }
  .title a:focus-visible {
    outline: none;
  }
  .work:has(.title a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .summary {
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .facts {
    margin: 0;
    display: grid;
    gap: 0.25rem;
    font-size: var(--step--1);
  }
  .facts div {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }

  /* 技術タグは常にカードの下端にそろえる */
  .tags {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 60rem) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** 画像がないときの図柄に出す分類名 */
  category: string;
  /** 表示幅のヒント（レスポンシブ画像用） */
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', category, sizes = '(max-width: 640px) 100vw, (max-width: 960px) 50vw, 360px', loading = 'lazy' } = Astro.props;
const isSvg = src?.format === 'svg';
---

<div class="thumb">
  {
    src ? (
      isSvg ? (
        <img src={src.src} width={src.width} height={src.height} alt={alt} loading={loading} decoding="async" />
      ) : (
        <Image src={src} alt={alt} widths={[400, 800, 1200]} sizes={sizes} loading={loading} />
      )
    ) : (
      <div class="fallback" role="img" aria-label={alt || category}>
        <span>{category}</span>
      </div>
    )
  }
</div>

<style>
  .thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #111c2e;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 画像がない実績用の図柄 */
  .fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background-image: radial-gradient(circle at 1px 1px, #24344f 1px, transparent 0);
    background-size: 20px 20px;
  }
  .fallback span {
    padding: 0.4em 1em;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: var(--step--1);
    background: var(--paper);
  }
</style>

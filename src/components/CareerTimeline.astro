---
import profile from '../data/profile.json';
import { formatPeriod } from '../lib/works';
---

<ol class="timeline">
  {
    profile.career.map((c) => (
      <li>
        <p class="period">{formatPeriod(c.start, c.end || undefined)}</p>
        <h3>{c.title}</h3>
        <p class="org">{c.org}</p>
        <p class="desc">{c.description}</p>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }
  li {
    position: relative;
    padding: 0 0 2rem 1.75rem;
    border-left: 2px solid var(--line);
  }
  li:last-child {
    padding-bottom: 0;
  }
  li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--accent);
  }
  li:first-child::before {
    background: var(--accent);
  }
  .period {
    font-size: var(--step--1);
    color: var(--muted);
  }
  h3 {
    font-size: var(--step-1);
  }
  .org {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .desc {
    margin-top: 0.25rem;
  }
</style>

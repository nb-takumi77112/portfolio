---
/**
 * 強み・経歴・スキル・資格のセクション。
 * トップページと「経歴・スキル」ページの両方で使う（内容は src/data/profile.json）。
 */
import CareerTimeline from './CareerTimeline.astro';
import SkillList from './SkillList.astro';
import profile from '../data/profile.json';
---

<div class="about-sections">
  <section aria-labelledby="strengths-title" class="block">
    <h2 id="strengths-title" class="section-title">強み</h2>
    <ul class="strengths">
      {
        profile.strengths.map((st) => (
          <li>
            <h3>{st.title}</h3>
            <p>{st.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="career-title" class="block">
    <h2 id="career-title" class="section-title">経歴</h2>
    <CareerTimeline />
  </section>

  <section aria-labelledby="skills-title" class="block">
    <h2 id="skills-title" class="section-title">スキル</h2>
    <p class="hint">数字は実務での使用年数です。</p>
    <SkillList />
  </section>

  {
    profile.certifications.length > 0 && (
      <section aria-labelledby="cert-title" class="block">
        <h2 id="cert-title" class="section-title">資格</h2>
        <ul class="certs">
          {profile.certifications.map((c) => (
            <li>
              <span>{c.name}</span>
              <span class="year">{c.year}年取得</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .about-sections {
    display: grid;
    gap: clamp(3rem, 7vw, 4.5rem);
  }
  .block {
    display: grid;
    gap: 1.5rem;
  }
  .strengths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.25rem;
  }
  .strengths li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
  }
  .strengths h3 {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .strengths p {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .hint {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-top: -0.75rem;
  }
  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }
  .certs li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px dashed var(--line);
  }
  .year {
    color: var(--muted);
    font-size: var(--step--1);
    white-space: nowrap;
  }
</style>

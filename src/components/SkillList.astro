---
import profile from '../data/profile.json';

const maxYears = Math.max(...profile.skills.flatMap((g) => g.items.map((i) => i.years)));
---

<div class="skills">
  {
    profile.skills.map((group) => (
      <section class="group">
        <h3>{group.category}</h3>
        <dl>
          {group.items.map((item) => (
            <div class="row">
              <dt>{item.name}</dt>
              <dd>
                <span class="bar" style={`--ratio:${item.years / maxYears}`} aria-hidden="true" />
                <span class="years">{item.years}年</span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))
  }
</div>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2.5rem 3rem;
  }
  h3 {
    font-size: var(--step-0);
    margin-bottom: 0.75rem;
    color: var(--muted);
    font-family: var(--font-body);
    font-weight: 500;
  }
  dl {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.4rem;
    border-bottom: 1px dashed var(--line);
  }
  dt {
    font-weight: 500;
  }
  dd {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .bar {
    display: block;
    height: 6px;
    width: calc(var(--ratio) * 100%);
    max-width: calc(100% - 3rem);
    min-width: 4px;
    border-radius: 3px;
    background: var(--accent);
  }
  .years {
    font-size: var(--step--1);
    color: var(--muted);
    white-space: nowrap;
  }
</style>

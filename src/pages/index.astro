---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';
import AboutSections from '../components/AboutSections.astro';
import ContactBlock from '../components/ContactBlock.astro';
import profile from '../data/profile.json';
import { getWorks } from '../lib/works';
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import portrait from '../assets/profile.png';

const works = await getWorks();
const nameChars = Array.from(profile.name);
---

<BaseLayout>
  <div class="hero-band">
  <section class="hero wrap" aria-labelledby="hero-name">
    <h1 id="hero-name" class="name" aria-label={profile.name}>
      {
        nameChars.map((ch, i) =>
          ch.trim() === '' ? (
            <span class="gap" aria-hidden="true" />
          ) : (
            <span class="ch" style={`--i:${i}`} aria-hidden="true">
              {ch}
            </span>
          ),
        )
      }
    </h1>

    <Image
      class="portrait"
      src={portrait}
      alt={`${profile.name}の写真`}
      widths={[320, 480, 640]}
      sizes="(max-width: 60rem) 55vw, 16rem"
      loading="eager"
      fetchpriority="high"
    />

    <div class="intro">
      <p class="role">{profile.role}<span class="en">{profile.nameEn}</span></p>
      <p class="tagline">{profile.tagline}</p>
      <div class="summary">
        {profile.summary.map((p) => <p>{p}</p>)}
      </div>
      <div class="actions">
        <a class="button button--primary" href={url('works')}>実績を見る</a>
        <a class="button button--ghost" href={url('contact')}>仕事を相談する</a>
      </div>
    </div>
  </section>
  </div>

  <!-- 強み・経歴・スキル・資格（「経歴・スキル」ページと同じ内容） -->
  <div class="wrap block">
    <AboutSections />
  </div>

  <section class="wrap block" aria-labelledby="works-title">
    <div class="block-head">
      <h2 id="works-title" class="section-title">実績</h2>
      <a href={url('works')}>すべての実績（{works.length}件）</a>
    </div>
    <WorkList works={works} initial={6} step={3} />
  </section>

  <section class="wrap block" aria-labelledby="contact-title">
    <h2 id="contact-title" class="section-title">お仕事のご相談</h2>
    <ContactBlock />
  </section>
</BaseLayout>

<style>
  /* ヒーロー背景：方眼の点。下に向かって消える */
  .hero-band {
    position: relative;
    isolation: isolate;
  }
  .hero-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(circle at 1px 1px, rgba(143, 163, 191, 0.22) 1px, transparent 0);
    background-size: 24px 24px;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas: 'intro photo name';
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    row-gap: 2rem;
    align-items: start;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 5rem);
  }
  .intro {
    margin-right: clamp(0rem, 3vw, 2.5rem);
  }

  /* 写真：縦長に切り抜き、名前の縦罫と高さの基準をそろえる */
  .hero :global(.portrait) {
    grid-area: photo;
    width: clamp(12rem, 18vw, 16rem);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  /* 縦書きの名前：右端に置き、日本語の縦組みと同じく右から読ませる */
  .name {
    grid-area: name;
    writing-mode: vertical-rl;
    font-size: clamp(3rem, 1.5rem + 4.5vw, 6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.14em;
    padding-left: clamp(1rem, 2vw, 1.75rem);
    border-left: 3px solid var(--accent);
    box-shadow: -10px 0 24px -14px var(--accent);
    white-space: nowrap;
  }
  .ch {
    display: inline-block;
    animation: ink 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 110ms + 150ms);
  }
  .gap {
    display: inline-block;
    inline-size: 0.35em;
  }
  @keyframes ink {
    from {
      opacity: 0;
      transform: translateY(-0.25em);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .intro {
    grid-area: intro;
    display: grid;
    gap: 1.5rem;
    max-width: var(--measure);
    align-self: center;
  }
  .role {
    color: var(--accent);
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  .en {
    letter-spacing: 0.04em;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-4);
    line-height: 1.55;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .summary {
    display: grid;
    gap: 0.75rem;
    color: var(--muted);
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .block {
    margin-top: clamp(3rem, 8vw, 5.5rem);
    display: grid;
    gap: 1.75rem;
  }
  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  /* 狭い画面：写真と名前を上に並べ、本文はその下 */
  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'photo name'
        'intro intro';
    }
    .intro {
      margin-right: 0;
    }
    .hero :global(.portrait) {
      width: min(55vw, 20rem);
    }
    .name {
      justify-self: start;
    }
  }
  @media (max-width: 40rem) {
    .name {
      font-size: 2.75rem;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSections from '../components/AboutSections.astro';
import profile from '../data/profile.json';
---

<BaseLayout title="経歴・スキル" description={`${profile.name}の経歴とスキルです。`}>
  <div class="wrap page">
    <header class="head">
      <h1>経歴・スキル</h1>
      <div class="summary">
        {profile.summary.map((p) => <p>{p}</p>)}
      </div>
    </header>

    <AboutSections />
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    gap: clamp(3rem, 7vw, 4.5rem);
  }
  .head {
    display: grid;
    gap: 1.25rem;
    max-width: var(--measure);
  }
  h1 {
    font-size: var(--step-3);
  }
  .summary {
    display: grid;
    gap: 0.75rem;
  }
</style>

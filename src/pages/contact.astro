---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import profile from '../data/profile.json';
// links が空配列でも型が付くようにする
const links = profile.links as { label: string; url: string }[];
---

<BaseLayout title="連絡先" description="お仕事のご相談はこちらからお送りください。">
  <div class="wrap page">
    <h1>連絡先</h1>
    <ContactBlock />
    {
      links.length > 0 && (
        <section class="elsewhere" aria-labelledby="links-title">
          <h2 id="links-title" class="section-title">ほかの場所</h2>
          <ul>
            {links.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="me noopener">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    gap: 2rem;
  }
  h1 {
    font-size: var(--step-3);
  }
  .elsewhere {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  ul {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
